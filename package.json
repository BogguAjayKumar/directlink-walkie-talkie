    "type": "git",
    "url": "https://github.com/BogguAjayKumar/directlink-walkie-talkie.git"
  },
  "keywords": [
    "webrtc",
    "walkie-talkie",
    "push-to-talk",
    "ptt",
    "intercom",
    "pwa",
    "audio-streaming",
    "e2ee",
    "vox",
    "emergency-beacon",
    "audio-dsp",
    "web-bluetooth",
    "tactical-radio",
    "websocket",
    "nodejs"
  ],
  "author": "Boggu Ajay Kumar",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "express": "^5.3.0",
    "localtunnel": "^2.0.2",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2"
  }
}
