{
  "name": "directlink-walkie-talkie",
  "version": "1.1.0",
  "description": "Tactical, instant, zero-latency WebRTC Push-to-Talk (PTT) audio intercom connecting phone and laptop with dedicated station master & handheld radio UIs, VOX hands-free, last-call replay, AES-256-GCM E2EE, SOS emergency beacon, and tactical RF DSP.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node test-signaling.js",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android"
  },
